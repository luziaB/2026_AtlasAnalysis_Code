   "source": [
    "# make contrast matrix, apply contrasts, and fit the model \n",
    "contrast.matrix <- makeContrasts(primary_tumour-metastatic_tumour,primary_tumour-healthy,primary_tumour-ascites, levels=design2) #compare primary to every other individually\n",
    "fit2 <- contrasts.fit(fit, contrast.matrix)\n",
    "fit2 <- eBayes(fit2)\n",
    "    "
   ]
  },
