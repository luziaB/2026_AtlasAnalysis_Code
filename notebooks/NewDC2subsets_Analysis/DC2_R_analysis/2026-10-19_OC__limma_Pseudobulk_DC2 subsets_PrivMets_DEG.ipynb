  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Multi-dimensional scaling (MDS) plot to visualise relationship between samples"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "library(RColorBrewer)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "# create vector of colours for sample types\n",
    "sample_types <- unique(sampleinfo$sample_type_major2)\n",
    "colors <- brewer.pal(n = length(sample_types), name = \"Accent\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [],
   "source": [
    "# set each sample type to a colour\n",
    "sample_colors <- setNames(colors, sample_types)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "metadata": {
    "vscode": {
     "languageId": "r"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "plot without title"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 600,
       "width": 600
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "options(repr.plot.height=10, repr.plot.width=10)\n",
    "layout(matrix(1:2, ncol = 2), widths = c(4, 1))  # Allocate space for the plot and legend\n",
    "\n",
    "# Generate the MDS plot\n",
    "plotMDS(y, \n",
    "        #labels = sampleinfo$sample_type_major2, \n",
    "        labels = NULL,\n",
    "        col = sample_colors[sampleinfo$sample_type_major2], \n",
    "        pch = 16,\n",
    "        top = 50, \n",
    "        gene.selection = \"common\", \n",
    "        prior.count = 5)\n",
    "\n",
    "# Add a legend\n",
    "par(mar = c(0, 0, 0, 0))  # Remove margins for the legend area\n",
    "plot.new()               \n",
    "legend(\"center\",                        \n",
    "       legend = sample_types,                 \n",
    "       col = colors,                        \n",
    "       pch = 16,                               \n",
    "       title = \"Sample Types\")               \n",
    "     "
   ]
  },
