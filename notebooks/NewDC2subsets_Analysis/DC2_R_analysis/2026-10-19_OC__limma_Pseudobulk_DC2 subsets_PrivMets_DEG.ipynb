   "source": [
    "# check the results\n",
    "tt1 <- topTable(fit2, coef=1, adjust=\"BH\", number = Inf) #primary_tumour-metastatic_tumour\n",
    "tt2 <- topTable(fit2, coef=2, adjust=\"BH\", number = Inf) #primary_tumour-healthy\n",
    "tt3 <- topTable(fit2, coef=3, adjust=\"BH\", number = Inf) #primary_tumour-ascites"
   ]
  },
